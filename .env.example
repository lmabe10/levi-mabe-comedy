# Copy to `.env` for local Vite UI development (public values only).
# Set secrets in Cloudflare Pages → Settings → Environment variables for production.
# For full-stack local testing with Functions, use `.dev.vars` (see CONTACT-FORM.md).

# Public — safe for the browser bundle (Vite only exposes VITE_*)
VITE_TURNSTILE_SITE_KEY=
VITE_JEFF_SHOWS_API_URL=https://jeffleesoncomedy.com/wp-json/jeff-shows/v1/shows

# Server-only — never prefix with VITE_
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
# TURNSTILE_SECRET_KEY=
# CONTACT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8788,http://127.0.0.1:8788,*.pages.dev
# CONTACT_TURNSTILE_EXPECTED_HOSTNAME=
